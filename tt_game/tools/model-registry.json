        }
      ],
      "params": [
        {
          "name": "hours",
          "label": "墙钟预算 hours（0=不限时）",
          "type": "number",
          "default": 0,
          "min": 0,
          "max": 96,
          "step": 0.5,
          "desc": "墙钟预算：到点在轮次/检查点边界停，可从 --resume 接着跑；续训扣掉断点里已累计的耗时，18h 可跨多次中断累计。按实测吞吐（tools/_probe_thr.js，含梯度更新）约 1.2 回合/秒，18h ≈ 76000 训练回合。"
        },
        {
          "name": "games",
          "label": "训练回合上限 games",
          "type": "int",
          "default": 900000,
          "min": 50,
          "max": 5000000,
          "step": 500,
          "desc": "ε 与课程衰减的**标尺**（跑到第 games 回合 ε 才满衰减），不是硬回合数——墙钟预算才是真正到点。按 1.2 回合/秒估：18h ≈ 76000。续训起点若已越过 games，脚本按剩余预算自动放宽上限（不会空转）。"
        },
        {
          "name": "eval",
          "label": "每档验证局数 eval",
          "type": "int",
          "default": 40,
          "min": 4,
          "max": 120,
          "step": 4,
          "desc": "轮末对每一档对手各打这么多局。验证是**纯推理**（约 4.4 局/秒），5 档×24 局≈120 局≈29 秒，只占每轮约 2%——不是瓶颈，可放心给足局数换取统计稳定性。"
        },
        {
          "name": "step",
          "label": "轮次长度 step(回合)",
          "type": "int",
          "default": 500,
          "min": 50,
          "max": 20000,
          "step": 50,
          "desc": "每 step 个回合做一轮：轮末跑一遍全阶梯验证并落一个曲线点。含梯度的实测吞吐约 1.2 回合/秒，所以 step 1500 ≈ 21 分钟一轮。"
        },
        {
