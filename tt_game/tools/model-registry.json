        },
        {
          "name": "layer-lr",
          "label": "分层学习率 lrScale",
          "type": "text",
          "default": "1,1,1,3",
          "desc": "逗号分隔、长度=层数，末位=952维输出层。梯度实测输出层范数是隐层1/10，末位3x后 300局 +10.0pp（三臂全胜）。"
        },
        {
          "name": "grad-clip",
