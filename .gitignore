# ===== 部署面收缩（2026-09）：爬虫/导入器与内部审计只在本地留存，不随站点发布 =====
# tools/ 仅保留 CI 使用的工具与访客提交流水线工具
tools/*
!tools/sync_content.py
!tools/ci_validate.py
!tools/generate_meta.py
!tools/recompute_rankings.js
!tools/append_submission.py
!tools/import_submissions_csv.py
!tools/gen_assets_manifest.py
!tools/gen_dataset_stats.py
!tools/i18n_audit.py
# import_submissions_csv.py 的去重状态（tools/* 规则已默认忽略，此处显式声明意图）
tools/.import-state.json
# 内部审计与一次性导入记录
docs/audit-2026-08-implementation.md
docs/skovde-2001-import-summary.md

# ===== 部署时生成的产物（2026-09-11 起）：不进 git，避免与部署机器人冲突 =====
# data/api/ 由 deploy 工作流在部署时运行 tools/recompute_rankings.js 现场生成
data/api/
# Assets/manifest.json 由 deploy 工作流在部署时运行 tools/gen_assets_manifest.py 现场生成
# （docs.html 素材库数据源；本地开发需手动运行一次该脚本）
Assets/manifest.json
# data/dataset-stats.json 由 deploy 工作流在部署时运行 tools/gen_dataset_stats.py 现场生成
# （data_scale.html 数据规模页的数据源；本地开发需手动运行一次该脚本）
data/dataset-stats.json
# 本地海报调试预览图，不随站点发布
.poster-preview/
# 社展离线版产物（tools/build_offline.py 生成，只存在于本地磁盘）
offline_pkg/
offline_pkg.building/
